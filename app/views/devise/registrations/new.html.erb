<% content_for :page_title, "Criar conta" %>
<% content_for :meta_description, "Crie sua conta no GO ATendi para acessar a plataforma de atendimento inteligente." %>

<section class="go-auth-page">
  <div class="container">
    <div class="go-auth-shell">
      <div class="go-auth-panel">
        <%= link_to root_path, class: "go-auth-panel__logo-link" do %>
          <%= image_tag "go-atendi-logo.webp", alt: "GO ATendi", class: "go-auth-panel__logo" %>
        <% end %>

        <span class="go-auth-badge">Cadastro</span>

        <h1>Comece com o GO ATendi</h1>

        <p>
          Crie sua conta para acessar a plataforma e preparar sua operação de atendimento.
        </p>

        <div class="go-auth-highlights">
          <div>
            <i class="fa-solid fa-comments"></i>
            <span>Conversas centralizadas</span>
          </div>

          <div>
            <i class="fa-solid fa-wand-magic-sparkles"></i>
            <span>Automação com inteligência</span>
          </div>

          <div>
            <i class="fa-solid fa-chart-simple"></i>
            <span>Leads e oportunidades no controle</span>
          </div>
        </div>
      </div>

      <div class="go-auth-form-card">
        <div class="go-auth-form-card__header">
          <h2>Criar conta</h2>

          <p>
            Preencha os dados abaixo para continuar.
          </p>
        </div>

        <%= render "devise/shared/error_messages", resource: resource %>

        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "go-auth-form" }) do |f| %>
          <div class="go-auth-field">
            <%= f.label :email, "E-mail" %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "seuemail@empresa.com" %>
          </div>

          <div class="go-auth-field">
            <%= f.label :password, "Senha" %>
            <%= f.password_field :password, autocomplete: "new-password", placeholder: "Crie uma senha" %>

            <% if @minimum_password_length %>
              <small>Mínimo de <%= @minimum_password_length %> caracteres.</small>
            <% end %>
          </div>

          <div class="go-auth-field">
            <%= f.label :password_confirmation, "Confirmar senha" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Repita sua senha" %>
          </div>

          <%= f.submit "Criar minha conta", class: "go-auth-submit" %>
        <% end %>

        <div class="go-auth-form-card__legal">
          Ao continuar, você concorda com nossos
          <%= link_to "Termos", termos_path %> e
          <%= link_to "Política de Privacidade", privacidade_path %>.
        </div>

        <div class="go-auth-form-card__footer">
          <span>Já tem uma conta?</span>
          <%= link_to "Entrar", new_user_session_path %>
        </div>
      </div>
    </div>
  </div>
</section>
