<footer class="go-footer">
  <div class="container">
    <div class="go-footer__main">
      <div class="go-footer__brand">
        <%= link_to root_path, class: "go-footer__logo-link", aria: { label: "Ir para a página inicial do GO ATendi" } do %>
          <%= image_tag "go-atendi-logo.png", alt: "GO ATendi", class: "go-footer__logo" %>
        <% end %>

        <p class="go-footer__description">
          O GO ATendi centraliza conversas, automatiza atendimentos e ajuda
          empresas a organizarem oportunidades em uma única plataforma.
        </p>

        <div class="go-footer__contact-list">
          <div class="go-footer__contact-item">
            <i class="fa-brands fa-whatsapp"></i>
            <span>(11) 99664-5302</span>
          </div>

        </div>

        <div class="go-footer__socials">
          <a href="#" class="go-footer__social-link" aria-label="Instagram">
            <i class="fa-brands fa-instagram"></i>
          </a>

          <a href="#" class="go-footer__social-link" aria-label="Facebook">
            <i class="fa-brands fa-facebook-f"></i>
          </a>

          <a href="#" class="go-footer__social-link" aria-label="LinkedIn">
            <i class="fa-brands fa-linkedin-in"></i>
          </a>
        </div>
      </div>

      <div class="go-footer__links">
        <div class="go-footer__column">
          <h3>Produto</h3>

          <ul>
            <li><%= link_to "Soluções", solucoes_path %></li>
            <li><%= link_to "Funcionalidades", funcionalidades_path %></li>
            <li><%= link_to "Resultado", resultado_path %></li>
            <li><%= link_to "Preço", preco_path %></li>
            <li><%= link_to "Inscrever-se", new_user_registration_path %></li>
          </ul>
        </div>

        <div class="go-footer__column">
          <h3>Recursos</h3>

          <ul>
            <li><%= link_to "Blog", "#" %></li>
            <li><%= link_to "Central de ajuda", "#" %></li>
            <li><%= link_to "Demonstração", new_user_registration_path %></li>
          </ul>
        </div>

        <div class="go-footer__column">
          <h3>Conta</h3>

          <ul>
            <li><%= link_to "Política de Privacidade", privacidade_path %></li>
            <li><%= link_to "Termos de Serviço", termos_path %></li>
            <li><%= link_to "Política de Cookies", cookies_policy_path %></li>
            <li><%= link_to "LGPD", lgpd_path %></li>
            <li><%= link_to "Exclusão de dados", data_deletion_path %></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="go-footer__bottom">
      <div class="go-footer__legal">
        <span>© <%= Time.current.year %> GO ATendi. Desenvolvido por Sollucion</span>
        <span>CNPJ: 56.365.822/0001-20</span>
        <span>Todos os direitos reservados</span>
      </div>

      <div class="go-footer__policy-links">
        <%= link_to "Privacidade", privacidade_path %>
        <%= link_to "Termos", termos_path %>
        <%= link_to "Cookies", cookies_policy_path %>
        <%= link_to "LGPD", lgpd_path %>
        <%= link_to "Exclusão de dados", data_deletion_path %>
      </div>
    </div>
  </div>
</footer>
