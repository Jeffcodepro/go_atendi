<% content_for :page_title, "Exclusão de Dados do Usuário" %>
<% content_for :meta_description, "Exclusão de Dados da GO ATendi: saiba como solicitar a exclusão dos seus dados pessoais, quais dados podem ser removidos e quais podem ser retidos por obrigação legal." %>

