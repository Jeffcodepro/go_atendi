# Git
/.git/
/.gitignore

# Bundler
/.bundle

# Environment files
/.env
/.env.*
!/.env.example
!/.env*.erb

# Rails credentials keys
/config/master.key
/config/credentials/*.key

# Logs and temp files
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# PID files
/tmp/pids/*
!/tmp/pids/.keep

# Storage
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Node / build artifacts
/node_modules/
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets
/public/packs
/public/packs-test

# Test / coverage
/coverage/
/spec/tmp/
/test/tmp/

# OS/editor files
.DS_Store
.idea/
.vscode/
*.swp
